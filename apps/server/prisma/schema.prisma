generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  SUPPORT
  MONITORING
  VENDOR
  AUDITOR
  DEALER
  FRANCHISE
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum LicenseStatus {
  ACTIVE
  SUSPENDED
  REVOKED
  EXPIRED
}

enum ClientState {
  ONLINE
  OFFLINE
  BANNED
  UNLICENSED
}

enum AuditSeverity {
  INFO
  WARNING
  CRITICAL
}

model AdminUser {
  id                  String          @id @default(cuid())
  username            String          @unique
  passwordHash        String
  role                UserRole        @default(ADMIN)
  tenantId            String?
  tenant              Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  dealerName          String?
  dealerPhone         String?
  dealerEmail         String?
  notes               String?
  isActive             Boolean         @default(true)
  forcePasswordChange Boolean         @default(false)
  failedLoginCount    Int             @default(0)
  tokenVersion        Int             @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  auditLogs           AuditLog[]
  dealerProducts      DealerProduct[]
  dealerLicenses      License[]       @relation("DealerLicenses")
  dealerApiKeys       ApiKey[]        @relation("DealerApiKeys")
  createdApiKeys      ApiKey[]        @relation("CreatedApiKeys")

  @@index([tenantId])
  @@index([role, isActive])
}

model Tenant {
  id          String       @id @default(cuid())
  publicId    String       @unique @default(uuid())
  code        String       @unique
  name        String
  description String?
  status      TenantStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  products    Product[]
  users       AdminUser[]
  auditLogs   AuditLog[]

  @@index([status])
}

model Product {
  id                String          @id @default(cuid())
  publicId          String          @unique @default(uuid())
  tenantId          String
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  code              String
  name              String
  description       String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  modules           Module[]
  licenses          License[]
  dealerAssignments DealerProduct[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model DealerProduct {
  id        String    @id @default(cuid()) @db.VarChar(36)
  userId    String    @db.VarChar(64)
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String    @db.VarChar(64)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model Module {
  id          String          @id @default(cuid())
  publicId    String          @unique @default(uuid())
  productId   String
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  code        String
  name        String
  description String?
  enabled     Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  licenses    LicenseModule[]

  @@unique([productId, code])
  @@index([productId, enabled])
}

model License {
  id                 String          @id @default(cuid())
  serial             String          @unique
  customerRef        String?
  customerTenant     String?         @db.VarChar(120)
  status             LicenseStatus   @default(ACTIVE)
  productId          String
  product            Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  dealerId           String?         @db.VarChar(64)
  dealer             AdminUser?      @relation("DealerLicenses", fields: [dealerId], references: [id], onDelete: SetNull)
  tokenHash          String          @unique
  hwidHash           String?
  maxActivations     Int             @default(1)
  validFrom          DateTime        @default(now())
  expiresAt          DateTime?
  lastValidatedAt    DateTime?
  revokedAt          DateTime?
  revokeReason       String?
  metadata           Json?
  entitlementVersion Int             @default(1)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  activations        Activation[]
  modules            LicenseModule[]

  @@index([status])
  @@index([productId])
  @@index([dealerId])
}

model ApiKey {
  id             String     @id @default(cuid()) @db.VarChar(36)
  key            String     @unique @db.VarChar(128)
  name           String     @db.VarChar(120)
  allowedDomains String     @default("*") @db.VarChar(500)
  role           String     @default("READ_EXTEND") @db.VarChar(64)
  dealerId       String?    @db.VarChar(64)
  dealer         AdminUser? @relation("DealerApiKeys", fields: [dealerId], references: [id], onDelete: SetNull)
  createdById    String?    @db.VarChar(64)
  createdBy      AdminUser? @relation("CreatedApiKeys", fields: [createdById], references: [id], onDelete: SetNull)
  expiresAt      DateTime
  isActive       Boolean    @default(true)
  lastUsedAt     DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([key])
  @@index([isActive, expiresAt])
  @@index([dealerId])
}

model LicenseModule {
  licenseId String
  license   License  @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  moduleId  String
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@id([licenseId, moduleId])
  @@index([moduleId])
}

model Activation {
  id                 String      @id @default(cuid())
  licenseId          String
  license            License     @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  clientId           String      @unique
  hwidHash           String
  tenantPublicId     String
  productPublicId    String
  tlsCertFingerprint String?
  appVersion         String?
  platform           String?
  state              ClientState @default(OFFLINE)
  lastIp             String?
  connectedAt        DateTime?
  lastHeartbeatAt    DateTime?
  disconnectedAt     DateTime?
  bannedAt           DateTime?
  banReason          String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@unique([licenseId, hwidHash])
  @@index([state])
  @@index([lastHeartbeatAt])
  @@index([tenantPublicId, productPublicId])
}

model AuditLog {
  id         BigInt        @id @default(autoincrement())
  actorId    String?
  actor      AdminUser?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  tenantId   String?
  tenant     Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  severity   AuditSeverity @default(INFO)
  ip         String?
  userAgent  String?
  requestId  String?
  details    Json?
  createdAt  DateTime      @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([action])
  @@index([tenantId, createdAt])
}
