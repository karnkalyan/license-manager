NODE_ENV=development
PORT=8081
TCP_PORT=7443
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD_FILE=./secrets/mysql_password.txt
DATABASE_NAME=license_manager
DATABASE_ALLOW_PUBLIC_KEY_RETRIEVAL=false
ADMIN_ORIGIN=http://localhost:5173
JWT_ISSUER=secure-license-manager
JWT_AUDIENCE=licensed-app
ADMIN_JWT_SECRET=change-me-to-at-least-32-random-bytes
ADMIN_SESSION_MINUTES=480
HWID_PEPPER=change-me-to-at-least-32-random-bytes
LICENSE_PRIVATE_KEY_PATH=./certs/dev/license-ed25519-private.pem
LICENSE_PUBLIC_KEY_PATH=./certs/dev/license-ed25519-public.pem
TLS_KEY_PATH=./certs/dev/server-key.pem
TLS_CERT_PATH=./certs/dev/server-cert.pem
TLS_CA_PATH=./certs/dev/ca-cert.pem
TLS_REQUIRE_CLIENT_CERT=true
TRUST_PROXY=false
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-bootstrap-password
BOOTSTRAP_ALLOW_WEAK_PASSWORD=false
